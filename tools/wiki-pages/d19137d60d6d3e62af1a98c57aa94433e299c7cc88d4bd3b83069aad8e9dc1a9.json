60,2730|1143,2765\n|leagueRegion = N/A\n}}\n{{LocLine\n|location = [[Sapphire Sea]] - west of [[the Crown Jewel]]\n|levels = 78\n|members = Yes\n|1753,2637|1744,2659|1744,2632|1761,2630|1747,2648|1735,2652|1735,2643\n|leagueRegion = N/A\n}}\n{{LocLine\n|location = [[Sea of Shells]] - south-east of [[the Summer Shore]]\n|levels = 78\n|members = Yes\n|3212,2311|3205,2328|3211,2339|3225,2336|3236,2326|3239,2307|3244,2315|3252,2305|3220,2304|3224,2312|3228,2319|3216,2325\n|leagueRegion = N/A\n}}\n{{LocLine\n|location = [[The Skullhorde]] - south-west of the [[Void Knights' Outpost]]\n|levels = 78\n|members = Yes\n|2560,2535|2567,2543|2553,2544|2543,2551|2555,2559|2546,2568|2556,2570|2528,2569|2538,2572|2541,2586|2548,2579|2560,2551\n|leagueRegion = N/A\n}}\n{{LocLine\n|location = [[Southern Expanse]] - north-east of [[Sunbleak Island]]\n|levels = 78\n|members = Yes\n|2264,2421|2276,2416|2282,2401|2263,2401|2260,2392|2272,2390|2256,2379|2250,2365|2241,2361|2243,2335|2249,2350\n|leagueRegion = N/A\n}}\n{{LocLine\n|location = [[Western Gate]] - north of [[Deepfin Point]]\n|levels = 78\n|members = Yes\n|1966,2857|1952,2855\n|leagueRegion = N/A\n}}\n{{LocTableBottom}}\n\n==Bounty info==\n{{BountyTaskList|monster=Frigatebird}}\n\n==Drops==\n{{DropLogProject|kills=26914}}\n\nThe average value of a Frigatebird kill is {{Coins|{{Average drop value|raw=yes}}}}.\n\n===100%===\n{{DropsTableHead}}\n{{DropsLine|name=Bones|quantity=1|rarity=Always}}\n{{DropsTableBottom}}\n\n===Seeds and frags===\n''There is a 6/50 chance of rolling the [[Sailing seed drop table]], and a 3/50 chance of rolling the [[Sailing frag drop table]].\n{{DropsTableHead}}\n{{DropsLine|name=Flax seed|quantity=1|rarity=30/500}}\n{{DropsLine|name=Hemp seed|quantity=1|rarity=18/500}}\n{{DropsLine|name=Cotton seed|quantity=1|rarity=12/500}}\n{{DropsLine|name=Elkhorn frag|quantity=1|rarity=18/500}}\n{{DropsLine|name=Pillar frag|quantity=1|rarity=9/500}}\n{{DropsLine|name=Umbral frag|quantity=1|rarity=3/500}}\n{{DropsTableBottom}}\n\n===Bird nests===\n{{BirdNestDropTable|4/50}}\n\n===Other===\n{{DropsTableHead}}\n{{DropsLine|name=Feather|quantity=300-500|rarity=18/50}}\n{{DropsLine|name=Raw swordfish|quantity=1|rarity=5/50}}\n{{DropsLine|name=Raw lobster|quantity=1|rarity=2/50}}\n{{DropsLine|name=Ruby|quantity=1|rarity=5/50}}\n{{DropsLine|name=Ruby ring|quantity=1|rarity=5/50}}\n{{DropsLine|name=Maple roots|quantity=1|rarity=2/50}}\n{{DropsTableBottom}}\n\n===Tertiary===\n{{DropsTableHead}}\n{{DropsLine|name=Frigatebird feather|quantity=1|rarity=1/3|raritynotes=<ref name=bounty group=d>Only dropped while on an applicable [[bounty task]].</ref>}}\n{{DropsLine|name=Frigatebird beak|quantity=1|rarity=1/10|raritynotes=<ref name=bounty group=d />}}\n{{DropsLineClue|type=hard|rarity=1/170|approx=yes}}\n{{DropsTableBottom}}\n\n==Changes==\n{{Subject changes header}}\n{{Subject changes\n|date = 1 April 2026\n|update = Remaining Getting Around Changes\n|change = Reduced Hitpoints from 121 to 79 and combat level from 89 to 78.\n}}\n{{Subject changes\n|date = 18 March 2026\n|update = Boat Combat Fixes\n|change = To compensate for [[boat combat]] changes, frigatebirds received the following adjustments:\n* Hitpoints increased from 85 to 121.\n* Defence level increased from 0 to 40.\n* Combat level increased from 70 to 89.\n}}\n{{Subject changes footer}}\n\n{{Ship combat}}\n{{Port tasks}}"}}, "fetchedAt": "2026-10-06T04:22:14.964342+00:00", "dropHtml": "<table class=\"wikitable sortable filterable item-drops autosort=4,a\" style=\"text-align:center\">\n<tbody><tr>\n<th style=\"border-right: none;\" class=\"drops-img-header drop-disp-btn unsortable\" title=\"Sort items by category, rarity and name.\"></th>\n<th style=\"border-left: none;\" class=\"item-col\">Item</th>\n<th data-sort-type=\"number\">Quantity</th>\n<th>Rarity</th>\n<th class=\"ge-column\" data-sort-type=\"number\">Price</th>\n<th class=\"alch-column\" data-sort-type=\"number\">High Alch</th>\n</tr>\n\n<tr style=\"text-align:cent